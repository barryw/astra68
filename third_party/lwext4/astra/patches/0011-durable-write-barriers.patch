diff --git a/src/ext4_blockdev.c b/src/ext4_blockdev.c
--- a/src/ext4_blockdev.c
+++ b/src/ext4_blockdev.c
@@ -110,6 +110,20 @@ static int ext4_bdif_bwrite(struct ext4_blockdev *bdev, const void *buf,
 	return r;
 }
 
+int ext4_block_flush(struct ext4_blockdev *bdev)
+{
+	int r;
+
+	ext4_assert(bdev && bdev->bdif);
+	if (!bdev->bdif->flush)
+		return EOK;
+
+	ext4_bdif_lock(bdev);
+	r = bdev->bdif->flush(bdev);
+	ext4_bdif_unlock(bdev);
+	return r;
+}
