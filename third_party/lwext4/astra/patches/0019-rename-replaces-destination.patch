+static int ext4_reparent_dir(struct ext4_inode_ref *parent,
+			    struct ext4_inode_ref *child)
+{
+	bool idx = ext4_inode_has_flag(child->inode, EXT4_INODE_FLAG_INDEX);
+	struct ext4_dir_search_result result;
+	int r;
+
+	if (!idx) {
+		r = ext4_dir_find_entry(&result, child, "..", strlen(".."));
+		if (r != EOK)
+			return EIO;
+		ext4_dir_en_set_inode(result.dentry, parent->index);
+		ext4_trans_set_block_dirty(result.block.buf);
+		r = ext4_dir_destroy_result(child, &result);
+		if (r != EOK)
+			return r;
+	} else {
+#if CONFIG_DIR_INDEX_ENABLE
+		r = ext4_dir_dx_reset_parent_inode(child, parent->index);
+		if (r != EOK)
+			return r;
+#endif
+	}
+
+	ext4_fs_inode_links_count_inc(parent);
+	parent->dirty = true;
+	return EOK;
+}
