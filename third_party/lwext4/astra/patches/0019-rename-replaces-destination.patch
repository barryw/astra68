+static int ext4_release_replaced_inode(struct ext4_mountpoint *mp,
+				       uint32_t inode)
+{
+	struct ext4_inode_ref ref;
+	int release;
+	int r;
+
+	r = ext4_block_cache_write_back(mp->fs.bdev, 1);
+	if (r != EOK)
+		return r;
+	r = ext4_trunc_inode(mp, inode, 0);
+	release = ext4_block_cache_write_back(mp->fs.bdev, 0);
+	if (r == EOK)
+		r = release;
+	if (r != EOK)
+		return r;
+
+	r = ext4_trans_start(mp);
+	if (r != EOK)
+		return r;
+	r = ext4_fs_get_inode_ref(&mp->fs, inode, &ref);
+	if (r == EOK) {
+		ext4_inode_set_del_time(ref.inode, -1L);
+		r = ext4_fs_free_inode(&ref);
+		release = ext4_fs_put_inode_ref(&ref);
+		if (r == EOK)
+			r = release;
+	}
+	if (r != EOK)
+		ext4_trans_abort(mp);
+	else
+		r = ext4_trans_stop(mp);
+	return r;
+}
