+static int ext4_bdif_breadv(struct ext4_blockdev *bdev, void *const *bufs,
+			    const uint32_t *blk_cnts, uint64_t blk_id,
+			    uint32_t buf_cnt)
+{
+	ext4_bdif_lock(bdev);
+	int r = bdev->bdif->breadv(bdev, bufs, blk_cnts, blk_id, buf_cnt);
+	bdev->bdif->bread_ctr++;
