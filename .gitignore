# build artifacts
**/build/
**/target/
!emu/qemu/qemu-9.2/target/
!emu/qemu/qemu-9.2/target/m68k/
!emu/qemu/qemu-9.2/target/m68k/*.c
!emu/qemu/qemu-9.2/target/m68k/*.h
*.bit
*.elf
*.bin
*.d
!fpga/arty/linux/rootfs-overlay/etc/init.d/
!fpga/arty/linux/rootfs-overlay/etc/init.d/astra-firstboot
*.dSYM/
*.o
*.map
*.rom
*.img
*.dcp
*.jou
*.rpt
*.xsa
esp32/astrahost/build/
esp32/astrahost/build-provision/
esp32/astrahost/sdkconfig
/sw/stage0/test_fat_loader

# HDL sim
work/
*.wlf
transcript
vsim.log
*.vcd

# python
__pycache__/
*.pyc
.pytest_cache/

# Harte test data (large, fetched on demand)
sw/harte/data/
sw/harte/results/
*.json.gz

# ROM hex build products (regenerated from source via each ROM's Makefile)
*.hex
!fpga/soc/post_fonts.hex

# generated per-build (BUILD_ID = hash of RTL+firmware source)
sw/harte/build_id.h

# sim build products (CPU netlists regenerated by mkcore.sh; verilator obj_dir)
fpga/soc/sim/*_core.v
fpga/soc/sim/obj_dir/
fpga/soc/sim/obj_dir_harte/
fpga/soc/sim/obj_dir_*/
fpga/soc/sim/*.elf
fpga/soc/sim/*.bin

# oss_flow build products
fpga/soc/oss_flow/astra.json
fpga/soc/oss_flow/astra.config
fpga/soc/oss_flow/*.log
.superpowers/

# generated release evidence stays on the durable build store
docs/evidence/

# generated protocol bindings and packed boot payloads
fpga/arty/graphics/astra_render_protocol.vh
fpga/arty/linux/astra_render_protocol.h
sw/boot/assets/*.lz4

# OS
.DS_Store
