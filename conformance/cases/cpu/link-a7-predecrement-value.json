{
  "schema": 1,
  "id": "cpu/link-a7-stacks-predecrement-value",
  "description": "LINK A7 pushes the incoming A7 value, then loads the predecremented stack pointer and applies its frame displacement.",
  "authority": [
    "M68000 Family Programmer's Reference Manual, LINK description: push An, load the updated SP into An, then add the displacement"
  ],
  "requires": [
    "mc68030"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "a7": "0x00002000",
      "isp": "0x00002000",
      "pc": "0x00001000",
      "sr": "0x00002000"
    },
    "memory": [
      {
        "address": "0x00001000",
        "data": "4e57fff0"
      }
    ]
  },
  "run": {
    "mode": "instruction",
    "max_cycles": 200
  },
  "observe": [
    {
      "address": "0x00001ffc",
      "length": 4
    }
  ],
  "expect": {
    "terminal": "instruction",
    "cpu": {
      "a7": "0x00001fec",
      "isp": "0x00001fec",
      "pc": "0x00001004"
    },
    "memory": [
      {
        "address": "0x00001ffc",
        "data": "00002000"
      }
    ]
  }
}
