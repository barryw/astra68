{
  "schema": 1,
  "id": "cpu/nbcd-valid-packed-bcd",
  "description": "NBCD negates a valid packed-BCD operand and reports decimal borrow in X and C.",
  "authority": [
    "M68000 Family Programmer's Reference Manual, NBCD"
  ],
  "requires": [
    "mc68030"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "d0": "0x12340001",
      "pc": "0x00001000",
      "sr": "0x00002004"
    },
    "memory": [
      {
        "address": "0x00001000",
        "data": "4800"
      }
    ]
  },
  "run": {
    "mode": "instruction",
    "max_cycles": 100
  },
  "expect": {
    "terminal": "instruction",
    "cpu": {
      "d0": "0x12340099",
      "pc": "0x00001002",
      "sr": {
        "value": "0x00002011",
        "mask": "0x00002015"
      }
    }
  }
}
