{
  "schema": 1,
  "id": "cpu/add-long-register-carry-zero",
  "description": "ADD.L D1,D0 produces zero with X, Z, and C set.",
  "authority": [
    "M68000 Family Programmer's Reference Manual: ADD"
  ],
  "requires": [
    "mc68030"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "d0": "0xffffffff",
      "d1": "0x00000001",
      "pc": "0x00001000",
      "sr": "0x00002000"
    },
    "memory": [
      {
        "address": "0x00001000",
        "data": "d081"
      }
    ]
  },
  "run": {
    "mode": "instruction",
    "max_cycles": 100
  },
  "expect": {
    "terminal": "instruction",
    "cpu": {
      "d0": "0x00000000",
      "d1": "0x00000001",
      "pc": "0x00001002",
      "sr": {
        "value": "0x00002015",
        "mask": "0x0000201f"
      }
    }
  }
}
