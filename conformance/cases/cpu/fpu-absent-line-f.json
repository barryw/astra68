{
  "schema": 1,
  "id": "cpu/fpu-absent-line-f-vector-11",
  "description": "An FPU opcode takes F-line vector 11 because Astra68 has no floating-point coprocessor.",
  "authority": [
    "Astra68 hardware contract: no floating-point coprocessor",
    "M68000 Family Programmer's Reference Manual: F-line emulator exception"
  ],
  "requires": [
    "mc68030",
    "no-fpu"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "pc": "0x00001000",
      "sr": "0x00002000",
      "isp": "0x00008000"
    },
    "memory": [
      {
        "address": "0x0000002c",
        "data": "00002000"
      },
      {
        "address": "0x00001000",
        "data": "f2000000"
      },
      {
        "address": "0x00002000",
        "data": "4e714e71"
      }
    ]
  },
  "run": {
    "mode": "instruction",
    "max_cycles": 100
  },
  "observe": [
    {
      "address": "0x00007ff8",
      "length": 8
    }
  ],
  "expect": {
    "terminal": "instruction",
    "cpu": {
      "a7": "0x00007ff8",
      "pc": "0x00002000",
      "sr": {
        "value": "0x00002000",
        "mask": "0x0000f71f"
      },
      "isp": "0x00007ff8"
    },
    "memory": [
      {
        "address": "0x00007ff8",
        "data": "200000001000002c"
      }
    ]
  }
}
