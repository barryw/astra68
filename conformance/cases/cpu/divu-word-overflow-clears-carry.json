{
  "schema": 1,
  "id": "cpu/divu-word-overflow-clears-carry",
  "description": "DIVU.W clears C and sets V when the quotient cannot fit in 16 bits, leaving the dividend unchanged.",
  "authority": [
    "M68000 Family Programmer's Reference Manual, DIVU: C is always cleared; operands are unaffected on overflow"
  ],
  "requires": [
    "mc68030"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "d0": "0x00010000",
      "d1": "0x00000001",
      "pc": "0x00001000",
      "sr": "0x00002011"
    },
    "memory": [
      {
        "address": "0x00001000",
        "data": "80c1"
      }
    ]
  },
  "run": {
    "mode": "instruction",
    "max_cycles": 200
  },
  "expect": {
    "terminal": "instruction",
    "cpu": {
      "d0": "0x00010000",
      "d1": "0x00000001",
      "pc": "0x00001002",
      "sr": {
        "value": "0x00002012",
        "mask": "0x00002013"
      }
    }
  }
}
