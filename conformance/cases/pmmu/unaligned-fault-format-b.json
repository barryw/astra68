{
  "schema": 1,
  "id": "pmmu/unaligned-data-fault-format-b",
  "description": "An odd longword user-data access crosses into an invalid PMMU mapping, takes vector 2 rather than address-error vector 3, and builds the Motorola 46-word format-B frame.",
  "authority": [
    "MC68030 User's Manual, section 5: misaligned data accesses",
    "MC68030 User's Manual, Table 8-6: format-B bus-error stack frame",
    "MC68030 User's Manual, section 9: invalid-descriptor MMU faults"
  ],
  "derived_from": [
    "fpga/cpu/tg68k_c_030_mmu2/tests/motorola/tb_unaligned_pmmu_fault_motorola.vhd"
  ],
  "requires": [
    "mc68030",
    "pmmu",
    "format-b-frame"
  ],
  "initial": {
    "reset": true,
    "memory": [
      {
        "address": "0x00000000",
        "data": "000020000000010000000080000000c0"
      },
      {
        "address": "0x00000080",
        "data": "23fc0000000200001f004e722700"
      },
      {
        "address": "0x000000c0",
        "data": "23fc0000000300001f004e722700"
      },
      {
        "address": "0x00000100",
        "data": "f0384c001080f0002400f038400010884e714e7146fc00002039dffffffd23fcdeadbeef00001f0460fe"
      },
      {
        "address": "0x00001080",
        "data": "800000020000600080d04780"
      },
      {
        "address": "0x00006000",
        "data": "00000061100000612000006130000061400000615000006160000061700000618000006190000061a0000061b0000061c000006100000000e0000061f0000061"
      }
    ]
  },
  "run": {
    "mode": "memory",
    "max_cycles": 20000,
    "stop": {
      "address": "0x00001f00",
      "mask": "0xffffffff",
      "value": "0x00000002"
    }
  },
  "observe": [
    {
      "address": "0x00001f00",
      "length": 8
    },
    {
      "address": "0x00001fa4",
      "length": 28
    }
  ],
  "expect": {
    "terminal": "memory",
    "cpu": {
      "a7": "0x00001fa4"
    },
    "memory": [
      {
        "address": "0x00001f00",
        "data": "00000002"
      },
      {
        "address": "0x00001faa",
        "data": "b008"
      },
      {
        "address": "0x00001fae",
        "data": "0141",
        "mask": "f1f7"
      },
      {
        "address": "0x00001fb4",
        "data": "dffffffd"
      }
    ]
  }
}
