{
  "schema": 1,
  "id": "pmmu/translation-and-control-instructions",
  "description": "Enable translation through PMOVE, execute from a remapped page, PLOAD and PTEST a writable page, transfer MMUSR, write through translation, and flush the ATC.",
  "authority": [
    "MC68030 User's Manual, section 9: Memory Management Unit",
    "M68000 Family Programmer's Reference Manual: PMOVE, PLOAD, PTEST, PFLUSH"
  ],
  "requires": [
    "mc68030",
    "pmmu"
  ],
  "initial": {
    "reset": true,
    "cpu": {
      "a0": "0x00002000",
      "a1": "0x00002008",
      "a2": "0x00005000",
      "a4": "0x00005004"
    },
    "memory": [
      {
        "address": "0x00000000",
        "data": "0000800000001000"
      },
      {
        "address": "0x00001000",
        "data": "f0104c00f0114000"
      },
      {
        "address": "0x00002000",
        "data": "7fff00020000400080cc8000"
      },
      {
        "address": "0x00003008",
        "data": "f0122015203c112233442480f0129f71f0146200f000240023fcc0de600d0000500860fe"
      },
      {
        "address": "0x00004004",
        "data": "00003001"
      },
      {
        "address": "0x00004014",
        "data": "00006001"
      }
    ]
  },
  "run": {
    "mode": "memory",
    "max_cycles": 10000,
    "stop": {
      "address": "0x00006008",
      "mask": "0xffffffff",
      "value": "0xc0de600d"
    }
  },
  "observe": [
    {
      "address": "0x00004004",
      "length": 4
    },
    {
      "address": "0x00004014",
      "length": 4
    },
    {
      "address": "0x00006000",
      "length": 12
    }
  ],
  "expect": {
    "terminal": "memory",
    "cpu": {
      "d0": "0x11223344",
      "a3": "0x00004014"
    },
    "memory": [
      {
        "address": "0x00004004",
        "data": "00003009"
      },
      {
        "address": "0x00004014",
        "data": "00006019"
      },
      {
        "address": "0x00006000",
        "data": "1122334402010000c0de600d"
      }
    ]
  }
}
