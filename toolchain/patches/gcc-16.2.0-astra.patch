diff --git a/gcc/config/m68k/astra.h b/gcc/config/m68k/astra.h
new file mode 100644
--- /dev/null
+++ b/gcc/config/m68k/astra.h
@@ -0,0 +1,51 @@
+/* Astra68 MC68040 userspace ABI.  */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS() \
+  do { \
+    builtin_define ("__astra__"); \
+    builtin_define ("__ASTRA__"); \
+    builtin_assert ("system=astra"); \
+  } while (0)
+
+/* A4 is the thread pointer.  A5 remains available to the m68k PIC ABI.  */
+#undef DRIVER_SELF_SPECS
+#define DRIVER_SELF_SPECS "-ffixed-a4 -msoft-float"
+
+/* Keep Astra's established ILP32 ABI compatible with GNU/Linux m68k.  */
+#undef SIZE_TYPE
+#define SIZE_TYPE "unsigned int"
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "int"
+#undef STDINT_LONG32
+#define STDINT_LONG32 0
+
+/* Mark every generated object, including crtbegin/crtend, non-executable.  */
+#undef TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+/* Astra executables use the system's own startup object.  A shared library
+   has constructors but no process entry point.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "%{!shared:crt0-hosted.o%s} crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s"
+
+/* A normal executable is interpreted by Astra's versioned loader.  Bootstrap
+   and recovery images request -static explicitly and receive the matching
+   no-interpreter profile.  The NDK selects the matching executable linker
+   script from its versioned archive; the compiler owns only the target-wide
+   interpreter default.  The loader reads only DT_GNU_HASH: its Bloom
+   filter rejects an image that lacks a symbol in two loads, and its chains
+   compare hashes before names, so every dynamic link emits it, ports
+   included.  */
+#undef LINK_SPEC
+#define LINK_SPEC \
+  "%{shared:-shared} --hash-style=gnu " \
+  "%{!shared:%{!static:--dynamic-linker=loader.library.1}}"
+
+#undef LIB_SPEC
+#define LIB_SPEC \
+  "--start-group -lastraposix -lastrastreams -lastravfs -lastrart " \
+  "-lc -lm --end-group"
