 }
 
+/* Astra: integer <-> single conversions work in single precision.  The
+   generic versions went through double, which made every int <-> float
+   conversion a double conversion plus a double rounding: most of a soft-float
+   graphics client's arithmetic.  Rounding is to nearest, ties to even, as
+   __truncdfsf2 rounds; __fixsfsi truncates and saturates as __fixdfsi does. */
+
+/* ASTRA-SINGLE-CONVERSIONS-BEGIN */
+static float
+__astra_pack_sf (unsigned long mant, long sign)
+{
+  union float_long fl;
+  long exp;
+  unsigned long rest;
+
+  if (mant == 0)
+    {
+      fl.l = sign;
+      return fl.f;
+    }
+  /* The leading one moves to bit 31; the value is then 1.f * 2^(exp-127). */
+  exp = 31 + 127 - __builtin_clzl (mant);
+  mant <<= __builtin_clzl (mant);
+  rest = mant & 0xFFUL;
+  mant >>= 8;
+  if (rest > 0x80UL || (rest == 0x80UL && (mant & 1UL)))
+    {
+      mant++;
+      if (mant == (unsigned long) HIDDEN << 1)
+	{
+	  mant >>= 1;
+	  exp++;
+	}
+    }
+  fl.l = PACK (sign, exp, (long) (mant & ~(unsigned long) HIDDEN));
+  return fl.f;
+}
+
 /* convert unsigned int to float */
 float
 __floatunsisf (unsigned long l)
 {
-  double foo = __floatunsidf (l);
-  return foo;
+  return __astra_pack_sf (l, 0);
 }
 
 /* convert int to float */
 float
 __floatsisf (long l)
 {
-  double foo = __floatsidf (l);
-  return foo;
+  return l < 0 ? __astra_pack_sf (-(unsigned long) l, SIGNBIT)
+	       : __astra_pack_sf ((unsigned long) l, 0);
 }
+/* ASTRA-SINGLE-CONVERSIONS-END */
 
 /* convert float to double */
 double
@@ -386,12 +423,194 @@
 }
 
 /* convert float to int */
+/* ASTRA-FIX-SINGLE-BEGIN */
 long
 __fixsfsi (float a1)
 {
-  double foo = a1;
-  return __fixdfsi (foo);
+  union float_long fl;
+  long exp;
+  unsigned long l;
+
+  fl.f = a1;
+  exp = EXP (fl.l) - 127;
+  if (exp >= 31)
+    /* Return largest integer, as __fixdfsi does for Inf and NaN too.  */
+    return SIGN (fl.l) ? 0x80000000L : 0x7fffffffL;
+  if (exp < 0)
+    return 0;
+  l = (unsigned long) MANT (fl.l);
+  l = exp >= 23 ? l << (exp - 23) : l >> (23 - exp);
+  return SIGN (fl.l) ? -(long) l : (long) l;
 }
+/* ASTRA-FIX-SINGLE-END */
+
+/* Astra: single-precision multiply and divide in C.  lb1sf68.S built them
+   for the MC68000, which has no 32x32 multiply or 64/32 divide: both walked
+   the significand one bit a loop iteration, about 190 instructions a
+   multiply, and SDL_mixer's per-sample panning made that most of Chocolate
+   Doom's guest time.  The MC68040 does the significand in one MULU.L or
+   DIVU.L.  Results are IEEE single, rounded to nearest, ties to even, with
+   denormal operands and results; a NaN result is QUIET_NaN as lb1sf68.S
+   returns it.  They do not post lb1sf68.S's _fpCCR exception flags. */
+
+/* ASTRA-MUL-DIV-SINGLE-BEGIN */
+#define ASTRA_QUIET_NAN_SF 0x7fffffffL
+
+static float
+__astra_sf_from_bits (unsigned long bits)
+{
+  union float_long fl;
+
+  fl.l = (long) bits;
+  return fl.f;
+}
+
+/* Round a significand whose leading one is bit 31 (the value is
+   mant / 2^31 * 2^(exp - 127)) to single precision; sticky is nonzero when
+   bits below mant were lost.  Handles overflow to infinity and gradual
+   underflow. */
+static float
+__astra_round_sf (unsigned long sign, long exp, unsigned long mant,
+		  int sticky)
+{
+  unsigned long rest, bits;
+
+  if (exp >= 255)
+    return __astra_sf_from_bits (sign | 0x7f800000UL);
+  if (exp < 1)
+    {
+      unsigned long shift = (unsigned long) (1 - exp);
+
+      if (shift >= 32)
+	{
+	  sticky |= mant != 0;
+	  mant = 0;
+	}
+      else
+	{
+	  sticky |= (mant << (32 - shift)) != 0;
+	  mant >>= shift;
+	}
+      exp = 1;
+    }
+  rest = mant & 0xffUL;
+  mant >>= 8;
+  if (rest > 0x80UL || (rest == 0x80UL && (sticky || (mant & 1UL))))
+    mant++;
+  /* The hidden bit, when present, adds one to the exponent field; a
+     denormal has none, and rounding up into it makes the smallest normal. */
+  bits = ((unsigned long) (exp - 1) << 23) + mant;
+  if (bits >= 0x7f800000UL)
+    bits = 0x7f800000UL;
+  return __astra_sf_from_bits (sign | bits);
+}
+
+/* Significand with the leading one at bit 23 and its exponent; the operand
+   is finite and nonzero. */
+static unsigned long
+__astra_unpack_sf (unsigned long bits, long *exp)
+{
+  unsigned long mant = bits & 0x7fffffUL;
+
+  *exp = (long) ((bits >> 23) & 0xffUL);
+  if (*exp != 0)
+    return mant | (unsigned long) HIDDEN;
+  {
+    int shift = __builtin_clzl (mant) - 8;
+
+    *exp = 1 - shift;
+    return mant << shift;
+  }
+}
+
+float
+__mulsf3 (float a1, float a2)
+{
+  union float_long fl1, fl2;
+  unsigned long b1, b2, sign, m1, m2;
+  long e1, e2, exp;
+  __UINT64_TYPE__ product;
+
+  fl1.f = a1;
+  fl2.f = a2;
+  b1 = (unsigned long) fl1.l;
+  b2 = (unsigned long) fl2.l;
+  sign = (b1 ^ b2) & (unsigned long) SIGNBIT;
+  b1 &= 0x7fffffffUL;
+  b2 &= 0x7fffffffUL;
+  if (b1 > 0x7f800000UL || b2 > 0x7f800000UL)
+    return __astra_sf_from_bits (ASTRA_QUIET_NAN_SF);
+  if (b1 == 0x7f800000UL || b2 == 0x7f800000UL)
+    return (b1 == 0 || b2 == 0)
+	   ? __astra_sf_from_bits (ASTRA_QUIET_NAN_SF)
+	   : __astra_sf_from_bits (sign | 0x7f800000UL);
+  if (b1 == 0 || b2 == 0)
+    return __astra_sf_from_bits (sign);
+  m1 = __astra_unpack_sf (b1, &e1);
+  m2 = __astra_unpack_sf (b2, &e2);
+  /* [2^23, 2^24) squared is [2^46, 2^48): one MULU.L on the MC68040. */
+  product = (__UINT64_TYPE__) m1 * m2;
+  exp = e1 + e2 - 127;
+  if (product >> 47)
+    exp++;
+  else
+    product <<= 1;
+  return __astra_round_sf (sign, exp, (unsigned long) (product >> 16),
+			   (product & 0xffffU) != 0);
+}
+
+float
+__divsf3 (float a1, float a2)
+{
+  union float_long fl1, fl2;
+  unsigned long b1, b2, sign, m1, m2, quotient, remainder;
+  long e1, e2, exp;
+
+  fl1.f = a1;
+  fl2.f = a2;
+  b1 = (unsigned long) fl1.l;
+  b2 = (unsigned long) fl2.l;
+  sign = (b1 ^ b2) & (unsigned long) SIGNBIT;
+  b1 &= 0x7fffffffUL;
+  b2 &= 0x7fffffffUL;
+  if (b1 > 0x7f800000UL || b2 > 0x7f800000UL
+      || (b1 == 0x7f800000UL && b2 == 0x7f800000UL)
+      || (b1 == 0 && b2 == 0))
+    return __astra_sf_from_bits (ASTRA_QUIET_NAN_SF);
+  if (b1 == 0x7f800000UL || b2 == 0)
+    return __astra_sf_from_bits (sign | 0x7f800000UL);
+  if (b1 == 0 || b2 == 0x7f800000UL)
+    return __astra_sf_from_bits (sign);
+  m1 = __astra_unpack_sf (b1, &e1);
+  m2 = __astra_unpack_sf (b2, &e2);
+  /* m1 * 2^31 / m2 lies in (2^30, 2^32): one 64/32 DIVU.L. */
+#if defined (__mc68020__) || defined (__mc68030__) || defined (__mc68040__) \
+    || defined (__mc68060__)
+  {
+    unsigned long high = m1 >> 1, low = m1 << 31;
+
+    __asm__ ("divu%.l %2,%0:%1"
+	     : "+d" (high), "+d" (low) : "d" (m2) : "cc");
+    quotient = low;
+    remainder = high;
+  }
+#else
+  {
+    __UINT64_TYPE__ dividend = (__UINT64_TYPE__) m1 << 31;
+
+    quotient = (unsigned long) (dividend / m2);
+    remainder = (unsigned long) (dividend % m2);
+  }
+#endif
+  exp = e1 - e2 + 127;
+  if (!(quotient >> 31))
+    {
+      quotient <<= 1;
+      exp--;
+    }
+  return __astra_round_sf (sign, exp, quotient, remainder != 0);
+}
+/* ASTRA-MUL-DIV-SINGLE-END */
 
 #else /* EXTFLOAT */
 
