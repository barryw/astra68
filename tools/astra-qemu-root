#!/bin/bash
# astra-qemu-root -- loop-mount a copy of the caller's provider image as
# root, then run the caller's QEMU as the caller. QEMU never runs as root
# (docs/FILESYSTEM_PRODUCTION_PRD.md FS11).
#
# usage: sudo -n astra-qemu-root --image IMAGE [--env TZ=VALUE] -- QEMU ARGS...
#
# The caller is untrusted. Root opens, creates, chmods, mounts and
# unmounts paths only under R, a directory root makes with mktemp in
# /var/tmp (root-owned and sticky, so the caller can neither rename nor
# replace R) and keeps root:root 0711: the caller can reach a name inside
# R only by knowing it, and can change nothing in it. Every path the
# caller names is touched solely by a process running with the caller's
# own credentials (setpriv --reuid/--regid, --no-new-privs):
#
#   R/img      root's scratch copy of IMAGE, 0600. A caller-credential
#              reader opens IMAGE (no-follow, non-blocking), refuses
#              anything but a regular file, and sends its fstat size and
#              exactly that many bytes; root writes no more than that
#              size into R/img (sparse), and refuses a size the
#              filesystem under R cannot hold.
#   R/mnt      the mount point, 0755. The mounted filesystem's root is
#              the caller's own (root_provider's mkfs.ext4 -E root_owner).
#              Mounted nodev,nosuid,noexec.
#   R/qemu.pid QEMU's pid, 0644.
#
# The helper's first stdout line, before QEMU starts, is
#   ASTRA-QEMU-ROOT-MOUNT R/mnt
# so the caller finds the mount and the pid file without naming either.
#
# R is on /var/tmp, real disk, never tmpfs: a loop-mounted ext4 image
# backed by a tmpfs file breaks HostFS's write-back under QEMU (booting to
# the desktop with the scratch copy on /tmp works; the identical setup on
# /run, tmpfs, hangs before the desktop places an icon).
#
# The mount stays visible system-wide for the run. QEMU gets its own
# private mount namespace (a snapshot of the mount), so nothing outside
# can change what QEMU sees; unmounting the host copy once that snapshot
# existed raced QEMU's own HostFS init and the desktop never booted.
#
# The image must already contain `work` and `sound` directories
# (qemu_runtime.py's root_provider makes them at mkfs time). Root never
# creates anything inside the mounted filesystem; it only checks each
# entry is a real directory, not a symlink, and refuses otherwise.
#
# When QEMU exits, R/mnt is unmounted and R/img is written back to IMAGE
# by a caller-credential process (root opens only R/img). The mount, the
# loop device and R are always removed on exit, success or not.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

die() { echo "astra-qemu-root: $*" >&2; exit 64; }

[ "$(id -u)" -eq 0 ] || die "run through sudo"
[ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ] && [ -n "${SUDO_USER:-}" ] ||
    die "run through sudo"
[[ $SUDO_UID =~ ^[0-9]+$ && $SUDO_GID =~ ^[0-9]+$ ]] || die "run through sudo"

IMAGE= TZ_OVERRIDE=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --image)
            [ "$#" -ge 2 ] || die "--image needs a value"
            IMAGE=$2; shift 2 ;;
        --env)
            [ "$#" -ge 2 ] || die "--env needs a value"
            case "$2" in
                TZ=*) TZ_OVERRIDE=${2#TZ=} ;;
                *) die "environment $2 not allowed" ;;
            esac
            shift 2 ;;
        --) shift; break ;;
        *) die "unknown option $1" ;;
    esac
done
[ -n "$IMAGE" ] && [ "$#" -ge 1 ] || die "usage"

# Everything the caller names is opened only through this.
CALLER=(setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups
        --no-new-privs --)

# Without a trap a signal kills bash before its EXIT trap runs.
trap 'exit 143' TERM INT HUP

[ ! -L /var/tmp ] && [ "$(stat -c '%u %a' /var/tmp)" = "0 1777" ] ||
    die "/var/tmp must be root-owned and sticky"
R=$(mktemp -d /var/tmp/astra-qemu-root.XXXXXX) || die "mktemp failed"
LOOPDEV=
cleanup() {
    local status=$?
    set +e
    trap - TERM INT HUP
    if mountpoint -q -- "$R/mnt"; then
        # A caller process can hold the mount busy; detach it anyway.
        umount -- "$R/mnt" 2>/dev/null || umount -l -- "$R/mnt"
    fi
    # losetup -d takes no -- (util-linux 2.39 reads it as the device);
    # LOOPDEV is only ever this script's own `losetup -f --show` output.
    [ -n "$LOOPDEV" ] && losetup -d "$LOOPDEV"
    # Never recurse into a filesystem the caller owns.
    if mountpoint -q -- "$R/mnt"; then
        echo "astra-qemu-root: $R/mnt still mounted; leaving $R" >&2
    else
        rm -rf --one-file-system -- "$R"
    fi
    exit "$status"
}
trap cleanup EXIT
chmod 0711 -- "$R"
mkdir -m 0755 -- "$R/mnt"
PIDFILE=$R/qemu.pid

# Root opens only R/img; the caller-credential reader opens IMAGE and
# sends "SIZE\n" then exactly SIZE bytes.
read_image_as_caller() {
    "${CALLER[@]}" env -i PATH="$PATH" python3 -I -c '
import errno, os, stat, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK |
                 os.O_NOCTTY)
except OSError as error:
    if error.errno == errno.ELOOP:
        sys.exit("astra-qemu-root: image must be a regular file, not a symlink")
    sys.exit("astra-qemu-root: cannot open image: %s" % error.strerror)
info = os.fstat(fd)
if not stat.S_ISREG(info.st_mode):
    sys.exit("astra-qemu-root: image must be a regular file, not a symlink")
os.set_blocking(fd, True)
out = sys.stdout.buffer
out.write(b"%d\n" % info.st_size)
left = info.st_size
while left:
    chunk = os.read(fd, min(left, 1 << 20))
    if not chunk:
        sys.exit("astra-qemu-root: image shrank while it was read")
    out.write(chunk)
    left -= len(chunk)
out.flush()
' "$IMAGE" < /dev/null
}

write_scratch() {
    local size avail
    IFS= read -r size || return 1
    [[ $size =~ ^[0-9]{1,18}$ ]] || return 1
    avail=$(( $(stat -f -c %a -- "$R") * $(stat -f -c %S -- "$R") ))
    [ "$size" -le "$avail" ] || {
        echo "astra-qemu-root: image of $size bytes exceeds the $avail free in /var/tmp" >&2
        return 1
    }
    dd of="$R/img" bs=1M iflag=fullblock,count_bytes count="$size" \
        conv=sparse status=none || return 1
    [ "$(stat -c %s -- "$R/img")" = "$size" ]
}

read_image_as_caller | write_scratch ||
    die "could not read image as the caller"

LOOPDEV=$(losetup -f --show -- "$R/img") || die "losetup failed"
mount -o nodev,nosuid,noexec -- "$LOOPDEV" "$R/mnt" || die "mount failed"
for entry in work sound; do
    [ -d "$R/mnt/$entry" ] && [ ! -L "$R/mnt/$entry" ] ||
        die "provider missing $entry, or it is a symlink"
done

ENV_ARGS=(env -i "PATH=/usr/sbin:/usr/bin:/sbin:/bin"
          "ASTRA_HOSTFS_ROOT=$R/mnt")
[ -n "$TZ_OVERRIDE" ] && ENV_ARGS+=("TZ=$TZ_OVERRIDE")

echo "ASTRA-QEMU-ROOT-MOUNT $R/mnt"
# unshare execs setpriv in place, so $! is QEMU's own pid.
unshare --mount --propagation private -- "${CALLER[@]}" \
    "${ENV_ARGS[@]}" "$@" &
child=$!
echo "$child" > "$PIDFILE"
chmod 0644 -- "$PIDFILE"

trap 'kill -TERM "$child" 2>/dev/null || true' TERM INT HUP
set +e
wait "$child"
status=$?
while kill -0 "$child" 2>/dev/null; do
    wait "$child"
    status=$?
done
set -e
trap 'exit 143' TERM INT HUP

umount -- "$R/mnt" || die "cannot unmount"
"${CALLER[@]}" tee -- "$IMAGE" < "$R/img" > /dev/null ||
    die "could not write the image back to the caller"
exit "$status"
