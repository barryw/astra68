#!/bin/bash
# astra-qemu-root -- mount a provider image as root, then run the caller's
# QEMU as the caller. QEMU never runs as root: the only root action here
# is the loop mount. Reading the caller's image, running QEMU, and writing
# the result back all happen under the caller's own uid/gid, so this
# helper is never a wider door than the caller already has to their own
# files (docs/FILESYSTEM_PRODUCTION_PRD.md FS11).
#
# usage: sudo -n astra-qemu-root --image IMAGE --mount DIR
#            [--env TZ=VALUE] -- QEMU ARGS...
#
# IMAGE must be a regular file (not a symlink) in a caller-owned, mode
# 0700 directory directly under /tmp; DIR an empty caller-owned directory
# beside it. IMAGE is read with the caller's own credentials (setpriv
# --reuid/--regid) into a root-owned scratch copy next to it, so root
# never reads a byte the caller could not read, and a swap of IMAGE after
# this point touches only the caller's own file, never the scratch copy
# that gets mounted. (The scratch copy, and DIR, must be on real disk, not
# tmpfs: confirmed by booting to the desktop with them on /tmp -- beast's
# real disk -- against the identical setup on /run, which is tmpfs and
# hangs before the desktop ever places an icon. HostFS's write-back path
# under QEMU breaks on a loop-mounted ext4 image backed by a tmpfs file.)
#
# The copy is loop-mounted, nodev,nosuid,noexec, at DIR, in this
# process's own (the default, host-wide) mount namespace, and it stays
# mounted there for the whole run -- moving it into DIR's own root-owned
# directory, so it could be unmounted from here and hidden the moment a
# QEMU child's private namespace held an independent copy, was tried and
# confirmed broken: QEMU raced the host side of its own HostFS init
# against that early unmount and never finished booting, even though the
# identical mount left in place (as here) boots cleanly every time. QEMU
# still gets its own private mount namespace (a snapshot of this mount,
# below) -- nothing outside this process can change what QEMU sees once
# it starts -- but this namespace keeps the mount visible system-wide for
# the run's duration rather than hiding it from everything else, which a
# measurably broken earlier version of this script tried to do too early
# for QEMU's own HostFS init to tolerate. The loop device and the scratch
# copy are always removed when this script exits, success or not.
#
# DIR must already contain `work` and `sound` directories
# (qemu_runtime.py's root_provider populates them at mkfs time with
# `-d`, owned by the caller). This script never creates anything inside
# the mounted filesystem: it only checks each required entry is a real
# directory, never a symlink (checked without following one), and
# refuses otherwise.
#
# QEMU then runs as the caller (setpriv --reuid/--regid/--init-groups
# --no-new-privs, env -i with a fixed allowlist, inside its own private
# mount namespace so its view cannot be changed from outside once it
# starts), with ASTRA_HOSTFS_ROOT pointed at DIR: QEMU opens every file
# under it, and every -bios/-drive/-qmp path of its own, with the
# caller's own permissions, never root's. Those arguments need no
# validation here -- unprivileged QEMU can do nothing the caller could
# not already do by running it themselves.
#
# When QEMU exits, the scratch copy is written back to IMAGE with the
# caller's credentials, so IMAGE reflects what the run produced.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

die() { echo "astra-qemu-root: $*" >&2; exit 64; }

[ "$(id -u)" -eq 0 ] || die "run through sudo"
[ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ] && [ -n "${SUDO_USER:-}" ] ||
    die "run through sudo"

private_tmp_dir() {
    local dir
    dir=$(realpath -e -- "$1") || return 1
    case "$dir" in
        /tmp/*/*) return 1 ;;
        /tmp/?*) ;;
        *) return 1 ;;
    esac
    [ -d "$dir" ] && [ "$(stat -c %u "$dir")" = "$SUDO_UID" ] &&
        [ "$(stat -c %a "$dir")" = 700 ]
}

IMAGE= MOUNT= TZ_OVERRIDE=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --image)
            [ "$#" -ge 2 ] || die "--image needs a value"
            IMAGE=$2; shift 2 ;;
        --mount)
            [ "$#" -ge 2 ] || die "--mount needs a value"
            MOUNT=$2; shift 2 ;;
        --env)
            [ "$#" -ge 2 ] || die "--env needs a value"
            case "$2" in
                TZ=*) TZ_OVERRIDE=${2#TZ=} ;;
                *) die "environment $2 not allowed" ;;
            esac
            shift 2 ;;
        --) shift; break ;;
        *) die "unknown option $1" ;;
    esac
done
[ -n "$IMAGE" ] && [ -n "$MOUNT" ] && [ "$#" -ge 1 ] || die "usage"
# Resolved before anything is trusted about it: `-f` on a symlink answers
# for whatever it points to, which is not a question about IMAGE at all
# until the symlink is out of the picture.
[ ! -L "$IMAGE" ] && [ -f "$IMAGE" ] ||
    die "image must be a regular file, not a symlink"
private_tmp_dir "$(dirname -- "$IMAGE")" ||
    die "image must be a file in a private /tmp directory"
[ ! -L "$MOUNT" ] && [ -d "$MOUNT" ] ||
    die "mount point must be a directory, not a symlink"
[ "$(realpath -e -- "$(dirname -- "$MOUNT")")" = \
  "$(realpath -e -- "$(dirname -- "$IMAGE")")" ] ||
    die "mount point must sit beside the image"
[ "$(stat -c %u "$MOUNT")" = "$SUDO_UID" ] &&
    [ -z "$(ls -A -- "$MOUNT")" ] || die "mount point must be empty"

QEMU=$(realpath -e -- "$1") || die "no QEMU"
shift
[ -f "$QEMU" ] && [ -x "$QEMU" ] || die "QEMU must be an executable file"

SCRATCH=$(mktemp "$(dirname -- "$IMAGE")/astra-qemu-root-scratch.XXXXXX")
LOOPDEV=
MOUNTED=0
cleanup() {
    local status=$?
    set +e
    [ "$MOUNTED" = 1 ] && umount -- "$MOUNT"
    # losetup -d does not take a -- option terminator the way the rest of
    # this script's calls do (util-linux 2.39: `losetup -d -- DEV` fails
    # "No such device", treating "--" itself as the argument). LOOPDEV is
    # never anything but this script's own prior `losetup -f --show`
    # output, so there is nothing for -- to guard against here anyway.
    [ -n "$LOOPDEV" ] && losetup -d "$LOOPDEV"
    rm -f -- "$SCRATCH" "$(dirname -- "$MOUNT")/qemu.pid"
    exit "$status"
}
trap cleanup EXIT

# Snapshot the caller's image under the caller's own credentials: root
# never reads a byte the caller could not read, and a swap of IMAGE after
# this point touches only the caller's own file, not this copy.
setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups --no-new-privs \
    -- cat -- "$IMAGE" > "$SCRATCH" ||
    die "could not read image as the caller"

LOOPDEV=$(losetup -f --show -- "$SCRATCH") || die "losetup failed"
mount -o nodev,nosuid,noexec -- "$LOOPDEV" "$MOUNT" || die "mount failed"
MOUNTED=1
# Never created here -- only checked, with no-follow semantics, so a
# symlink planted at "work" or "sound" (into /etc, say) is refused rather
# than silently given to a directory-creation call that would follow it.
for entry in work sound; do
    [ -d "$MOUNT/$entry" ] && [ ! -L "$MOUNT/$entry" ] ||
        die "provider missing $entry, or it is a symlink"
done

ENV_ARGS=(env -i "PATH=/usr/sbin:/usr/bin:/sbin:/bin" "ASTRA_HOSTFS_ROOT=$MOUNT")
[ -n "$TZ_OVERRIDE" ] && ENV_ARGS+=("TZ=$TZ_OVERRIDE")

export SUDO_UID SUDO_GID
# QEMU still gets its own private mount namespace (a snapshot of the
# mount above): nothing outside this process can change what QEMU sees
# once it starts, even though -- see the top of this file -- this
# process's own namespace keeps the mount visible system-wide for the
# run's duration rather than hiding it.
unshare --mount --propagation private -- bash -c '
set -euo pipefail
exec setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups \
    --no-new-privs -- "$@"
' bash "${ENV_ARGS[@]}" "$QEMU" "$@" &
child=$!
echo "$child" > "$(dirname -- "$MOUNT")/qemu.pid"
chmod 0644 -- "$(dirname -- "$MOUNT")/qemu.pid"

trap 'kill -TERM "$child" 2>/dev/null || true' TERM INT HUP
set +e
wait "$child"
status=$?
while kill -0 "$child" 2>/dev/null; do
    wait "$child"
    status=$?
done
set -e

umount -- "$MOUNT" || die "cannot unmount"
MOUNTED=0
setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups --no-new-privs \
    -- tee -- "$IMAGE" < "$SCRATCH" > /dev/null ||
    die "could not write the image back to the caller"
exit "$status"
