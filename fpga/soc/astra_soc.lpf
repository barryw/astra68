## Astra 68 SoC skeleton — ULX3S 85F pin constraints
## Only the pins this bitstream uses (clk, reset button, LEDs, UART TX).
## Same sites as fpga/memtest/astra_memtest.lpf.

# NOTE: BLOCK RESETPATHS / BLOCK ASYNCPATHS were removed. They told TRACE to skip
# reset and cross-"domain" paths — which hid the WF68K30L's posedge<->negedge bus
# paths from analysis, so PAR never timing-fixed them (STA showed 0 errors while real
# HW stayed silent). Let TRACE see every path so the negedge bus interface gets fixed.

# 25 MHz oscillator
LOCATE COMP "clk25_mhz" SITE "G2";
IOBUF  PORT "clk25_mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25_mhz" 25 MHZ;

# CPU/bus clock = clk25_mhz/8 = 3.125 MHz (fabric divider bit clkdiv[2]).
# WITHOUT this the derived clock is only "covered under" the 25 MHz port, so TRACE
# times the whole CPU at 40 ns (4096 false setup errors) AND — the real bug — never
# analyzes the core's NEGATIVE-edge bus FFs (DSACK sample / read-data latch): 0
# falling-edge paths scored. Declaring clkdiv[2] a clock pulls BOTH edges into timing
# so PAR actually fixes the negedge cross-edge paths that fail in SDF sim / on silicon.
FREQUENCY NET "clkdiv[2]" 3.125 MHZ;
# Bound clock skew on the CPU/bus net. The residual failures are skew-induced HOLD
# violations (~150-300 ps) on the WF68K30L's dual-edge bus interface that TRACE scores
# as met (0 hold) but the SDF sim/silicon see. Force PAR to place the clock loads tight.
MAXSKEW NET "clkdiv[2]" 0.3 ns;

# Power button as manual reset (active low)
LOCATE COMP "reset_n" SITE "D6";
IOBUF  PORT "reset_n" PULLMODE=UP IO_TYPE=LVCMOS33;

# LEDs
LOCATE COMP "leds[7]" SITE "H3";
LOCATE COMP "leds[6]" SITE "E1";
LOCATE COMP "leds[5]" SITE "E2";
LOCATE COMP "leds[4]" SITE "D1";
LOCATE COMP "leds[3]" SITE "D2";
LOCATE COMP "leds[2]" SITE "C1";
LOCATE COMP "leds[1]" SITE "C2";
LOCATE COMP "leds[0]" SITE "B2";
IOBUF PORT "leds[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# UART TX to host via FTDI
LOCATE COMP "ftdi_rxd" SITE "L4";
IOBUF  PORT "ftdi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
