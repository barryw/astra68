BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "clk25_mhz" SITE "G2";
IOBUF  PORT "clk25_mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;

# FTDI
LOCATE COMP "ftdi_rxd"  SITE "L4";
LOCATE COMP "ftdi_txd"  SITE "M1";
LOCATE COMP "ftdi_ndtr" SITE "N1";
LOCATE COMP "ftdi_nrts" SITE "M3";
IOBUF  PORT "ftdi_rxd"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "ftdi_txd"  PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "ftdi_ndtr" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "ftdi_nrts" PULLMODE=UP IO_TYPE=LVCMOS33;

# This board reports ULX3S v3.0.8, but reset probing proved the v3.1 ESP route.
LOCATE COMP "wifi_rxd"   SITE "K3";
LOCATE COMP "wifi_txd"   SITE "K4";
LOCATE COMP "wifi_en"    SITE "J5";
LOCATE COMP "wifi_gpio0" SITE "F1";
IOBUF  PORT "wifi_rxd"   PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "wifi_txd"   PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "wifi_en"    PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "wifi_gpio0" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;

# Shared SD bus. ESP32 GPIO2 and SD D0 are the same J3 net. The passthrough
# explicitly leaves every one of these FPGA pads in high impedance.
LOCATE COMP "sd_clk"  SITE "H2";
LOCATE COMP "sd_cmd"  SITE "J1";
LOCATE COMP "sd_d[0]" SITE "J3";
LOCATE COMP "sd_d[1]" SITE "H1";
LOCATE COMP "sd_d[2]" SITE "K1";
LOCATE COMP "sd_d[3]" SITE "K2";
IOBUF PORT "sd_clk"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_cmd"  PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# LEDs
LOCATE COMP "leds[7]" SITE "H3";
LOCATE COMP "leds[6]" SITE "E1";
LOCATE COMP "leds[5]" SITE "E2";
LOCATE COMP "leds[4]" SITE "D1";
LOCATE COMP "leds[3]" SITE "D2";
LOCATE COMP "leds[2]" SITE "C1";
LOCATE COMP "leds[1]" SITE "C2";
LOCATE COMP "leds[0]" SITE "B2";
IOBUF  PORT "leds[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "leds[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
