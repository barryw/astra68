/dts-v1/;

/ {
    description = "FIT image for Astra 68 U-Boot script";
    #address-cells = <1>;

    images {
        default = "script";

        script {
            description = "Astra 68 U-Boot script";
            data = /incbin/("boot.cmd");
            type = "script";
            compression = "none";

            hash {
                algo = "crc32";
            };
        };
    };
};
