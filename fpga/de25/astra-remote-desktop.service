[Unit]
Description=Astra remote desktop
Before=astra.service
PartOf=astra.service
ConditionPathExists=/dev/astra-display-capture
ConditionFileIsExecutable=/var/lib/astra/current/bin/astra-remote-desktop

[Service]
Type=simple
RuntimeDirectory=astra
RuntimeDirectoryPreserve=yes
Environment=ASTRA_QMP_SOCKET=/run/astra/remote-desktop-qmp.sock
Environment=ASTRA_REMOTE_DESKTOP_CONTROL_SOCKET=/run/astra/remote-desktop-control.sock
Environment=ASTRA_RFB_LISTEN_ADDRESS=0.0.0.0
Environment=ASTRA_RFB_PASSWORD_FILE=/etc/astra/remote-desktop.password
ExecStart=/var/lib/astra/current/bin/astra-remote-desktop
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astra-remote-desktop
Nice=-5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
DevicePolicy=closed
DeviceAllow=/dev/astra-display-capture r
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=astra.service
