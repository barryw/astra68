[Unit]
Description=Astra remote desktop
Requires=astra.service
After=astra.service
PartOf=astra.service
ConditionPathExists=/dev/astra-display-capture
ConditionFileIsExecutable=/var/lib/astra/current/bin/astra-remote-desktop

[Service]
Type=simple
Environment=ASTRA_QMP_SOCKET=/run/astra/remote-desktop-qmp.sock
ExecStart=/var/lib/astra/current/bin/astra-remote-desktop
Restart=on-failure
RestartSec=1
Nice=-5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
DevicePolicy=closed
DeviceAllow=/dev/astra-display-capture r
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
