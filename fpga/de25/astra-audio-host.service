[Unit]
Description=Astra HDMI audio host
Before=astra.service
PartOf=astra.service
ConditionFileIsExecutable=/var/lib/astra/current/bin/astra-audio-host

[Service]
Type=simple
ExecStart=/var/lib/astra/current/bin/astra-audio-host
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astra-audio-host
CPUAffinity=0
Nice=-5
RuntimeDirectory=astra
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/mem rw
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=astra.service
