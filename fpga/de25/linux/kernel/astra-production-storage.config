# Full Image and every module must be rebuilt together for these options.
# CONFIG_CDROM changes struct gendisk; USB_UAS changes built-in usb-storage
# device selection. Never load this module set into the retained vendor Image.
CONFIG_LOCALVERSION="-astra-storage1-gd7d192a9ddd9"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLK_DEV_SR=m
CONFIG_CDROM=m
# These DMA modules are already used by the production DE25 shell.
CONFIG_DW_AXI_DMAC=m
CONFIG_DMATEST=m
