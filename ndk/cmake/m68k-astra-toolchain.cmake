# Cross-build Astra applications with an installed NDK.
get_filename_component(_ASTRA_NDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_SYSTEM_NAME Astra)
set(CMAKE_SYSTEM_PROCESSOR m68040)
set(CMAKE_C_COMPILER m68k-astra-gcc)
set(CMAKE_CXX_COMPILER m68k-astra-g++)
set(CMAKE_AR m68k-astra-ar)
set(CMAKE_RANLIB m68k-astra-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
list(PREPEND CMAKE_PREFIX_PATH "${_ASTRA_NDK_ROOT}")
list(PREPEND CMAKE_FIND_ROOT_PATH "${_ASTRA_NDK_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-m68040 -ffixed-a4 -D__astra__=1 -ffunction-sections -fdata-sections -fPIC -ftls-model=initial-exec")
set(CMAKE_CXX_FLAGS_INIT "-m68040 -ffixed-a4 -D__astra__=1 -ffunction-sections -fdata-sections -fPIC -ftls-model=initial-exec")
