set(PACKAGE_VERSION "@PACKAGE_VERSION@")
string(REGEX MATCH "^[0-9]+" _ASTRA_PACKAGE_MAJOR "${PACKAGE_VERSION}")
if((PACKAGE_VERSION MATCHES "-" AND
    PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION) OR
   PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION OR
   NOT PACKAGE_FIND_VERSION_MAJOR EQUAL _ASTRA_PACKAGE_MAJOR)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
