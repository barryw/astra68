PROJECT_NAME           = "Astra 68 NDK"
PROJECT_NUMBER         = $(ASTRA_NDK_VERSION)
PROJECT_BRIEF          = "Native Developer Kit for Astra 68"
OUTPUT_DIRECTORY       = build/docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
# The first sentence of a comment is its brief: the XML a tool reads then
# carries a <briefdescription> for every member, not only a detailed one.
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = NO

INPUT                  = include/astra ../sw/include/astra/gui.h \
                         ../sw/include/astra/message_abi.h \
                         ../sw/include/astra/pcm_format.h \
                         ../sw/include/astra/object_abi.h \
                         ../sw/include/astra/address_space.h \
                         ../sw/include/astra/application_service.h \
                         ../sw/include/astra/block.h \
                         ../sw/include/astra/bytes.h \
                         ../sw/include/astra/civil.h \
                         ../sw/include/astra/compiler.h \
                         ../sw/include/astra/display.h \
                         ../sw/include/astra/divide.h \
                         ../sw/include/astra/event.h \
                         ../sw/include/astra/event_descriptor.h \
                         ../sw/include/astra/host.h \
                         ../sw/include/astra/input.h \
                         ../sw/include/astra/library.h \
                         ../sw/include/astra/limits.h \
                         ../sw/include/astra/network.h \
                         ../sw/include/astra/ntp.h \
                         ../sw/include/astra/posix_process.h \
                         ../sw/include/astra/proc.h \
                         ../sw/include/astra/process.h \
                         ../sw/include/astra/program.h \
                         ../sw/include/astra/service_manager_abi.h \
                         ../sw/include/astra/shutdown.h \
                         ../sw/include/astra/status.h \
                         ../sw/include/astra/stream_service.h \
                         ../sw/include/astra/syscall.h \
                         ../sw/include/astra/vfs_service.h
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */internal/*
USE_MDFILE_AS_MAINPAGE =
EXAMPLE_PATH           = examples
EXAMPLE_PATTERNS       = *.c
EXAMPLE_RECURSIVE      = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/docs/doxygen-warnings.log

INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = ASTRA_EXTERN_C_BEGIN= \
                         ASTRA_EXTERN_C_END= \
                         ASTRA_NODISCARD= \
                         ASTRA_CLEANUP(x)= \
                         _Alignas(x)= \
                         ASTRA_BYTES_RESTRICT=

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
