diff --git a/target/m68k/translate.c b/target/m68k/translate.c
index ad3ce34..cbccbfc 100644
--- a/target/m68k/translate.c
+++ b/target/m68k/translate.c
@@ -4624,6 +4624,40 @@ DISAS_INSN(cinv)
 }
 
 #if !defined(CONFIG_USER_ONLY)
+DISAS_INSN(pmmu030)
+{
+    uint16_t extension;
+    unsigned command_class;
+    unsigned flush_mode;
+    bool needs_ea = true;
+    TCGv address;
+
+    if (IS_USER(s)) {
+        gen_exception(s, s->base.pc_next, EXCP_PRIVILEGE);
+        return;
+    }
+
+    extension = read_im16(env, s);
+    command_class = extension >> 13;
+    if (command_class == 1u && (extension & 0xfc00u) != 0x2000u) {
+        flush_mode = (extension >> 10) & 7u;
+        needs_ea = flush_mode == 6u;
+    }
+
+    if (needs_ea) {
+        address = gen_lea(env, s, insn, OS_UNSIZED);
+        if (address == NULL_QREG) {
+            address = tcg_constant_i32(0);
+        }
+    } else {
+        address = tcg_constant_i32(0);
+    }
+    gen_helper_pmmu030_op(tcg_env, address,
+                           tcg_constant_i32(extension),
+                           tcg_constant_i32(insn));
+    gen_exit_tb(s);
+}
+
